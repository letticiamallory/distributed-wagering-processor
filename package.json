{
  "name": "distributed-wagering-processor",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.5 <2"
  },
  "type": "module",
  "mikro-orm": {
    "configPaths": [
      "./src/infrastructure/persistence/mikro-orm.config.ts"
    ],
    "preferTs": true
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun src/main.ts",
    "migration:up": "bun --bun run mikro-orm migration:up",
    "migration:down": "bun --bun run mikro-orm migration:down",
    "migration:create": "bun --bun run mikro-orm migration:create",
    "lint": "oxlint --type-aware src/ test/",
    "check:money": "bun scripts/check-money.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1177.0",
    "@mikro-orm/core": "7.2.12",
    "@mikro-orm/migrations": "7.2.12",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "7.2.12",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  }
}
