# Copie para .env (o Bun lê o .env sozinho). O .env não vai para o Git.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet
SQS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Porta HTTP da aplicação (padrão 3000)
# PORT=3000
# Pool de conexões com o PostgreSQL, por processo (padrão 2 e 20; ADR-0007)
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# Quanto uma requisição espera por uma conexão livre do pool (e para abri-la) antes do 503 (ms;
# padrão 3000; ADR-0007)
# DB_ACQUIRE_TIMEOUT_MS=3000
# Prazo total do serviço `migrate` para conseguir a primeira conexão, tentando de novo com backoff
# (ms; padrão 180000)
# MIGRATE_CONNECT_DEADLINE_MS=180000

# Espera pelo lock de uma wallet antes de desistir com 503 (ms, 1 a 600000; padrão 5000)
# DB_LOCK_TIMEOUT_MS=5000
# Retry-After do 503, em segundos (1 a 3600; padrão 1)
# RETRY_AFTER_SECONDS=1
# SIGTERM: quanto tempo o servidor HTTP segue atendendo com o readiness em 503, para o balanceador
# tirar a instância (ms, 0 a 60000; padrão 5000), e o prazo para as conexões abertas terminarem
# depois disso (ms, 0 a 120000; padrão 10000)
# HTTP_SHUTDOWN_DRAIN_MS=5000
# HTTP_SHUTDOWN_TIMEOUT_MS=10000
# Política de espera de uma transação que aponta para uma referência que ainda não chegou
# (10 tentativas no total, espera de 1 s dobrando até 5 min: 511 s)
# PENDING_REFERENCE_MAX_ATTEMPTS=10
# PENDING_REFERENCE_BASE_DELAY_MS=1000
# PENDING_REFERENCE_MAX_DELAY_MS=300000
# Consumidor SQS (ADR-0011). Liga neste processo (true ou false; padrão true)
# SQS_CONSUMER_ENABLED=true
# SQS_QUEUE_NAME=wager-transactions.fifo
# SQS_DLQ_NAME=wager-transactions-dlq.fifo
# Entregas antes de ir para a DLQ (1 a 1000; padrão 10; tem que ser <= o redrive da fila)
# SQS_MAX_RECEIVE_COUNT=10
# Espera depois da falha n: min(2^n x base, teto), em segundos (padrão 2 e 60)
# SQS_RETRY_BASE_SECONDS=2
# SQS_RETRY_MAX_SECONDS=60
# Quanto esperar as mensagens em andamento no SIGTERM (ms; padrão 20000)
# SQS_SHUTDOWN_TIMEOUT_MS=20000
# Long polling do ReceiveMessage (0 a 20 s; padrão 20)
# SQS_WAIT_SECONDS=20
# Publisher da outbox (ADR-0012). Liga neste processo (true ou false; padrão true)
# OUTBOX_PUBLISHER_ENABLED=true
# OUTBOX_QUEUE_NAME=wallet-events.fifo
# Eventos por ciclo (1 a 10; padrão 10) e pausa entre ciclos vazios (ms; padrão 500)
# OUTBOX_BATCH_SIZE=10
# OUTBOX_POLL_INTERVAL_MS=500
# Prazo do envio ao SQS (a transação fica aberta; ms; padrão 5000)
# OUTBOX_SEND_TIMEOUT_MS=5000
# A partir de quantas tentativas o evento é "preso" e o log sobe para error (padrão 10)
# OUTBOX_STUCK_ATTEMPTS=10
# Intervalo da métrica do backlog da outbox (ms, 100 a 3600000; padrão 10000)
# OUTBOX_STATS_INTERVAL_MS=10000
# Quanto esperar o ciclo em andamento no SIGTERM (ms, 0 a 120000; padrão 10000)
# OUTBOX_SHUTDOWN_TIMEOUT_MS=10000
# Worker de PENDING_REFERENCE (ADR-0013). Liga neste processo (padrão true)
# PENDING_WORKER_ENABLED=true
# PENDING_WORKER_BATCH_SIZE=20
# PENDING_WORKER_POLL_INTERVAL_MS=1000
# Por quanto tempo um item reservado é "do" worker (ms; 1000 a 3600000; padrão 30000)
# PENDING_WORKER_LEASE_MS=30000
# Quanto esperar o ciclo em andamento no SIGTERM (ms, 0 a 120000; padrão 10000)
# PENDING_WORKER_SHUTDOWN_TIMEOUT_MS=10000
# Logs em JSON, um objeto por linha (ADR-0014). Nível mínimo: debug, info, warn, error ou fatal
# (padrão info)
# LOG_LEVEL=info
